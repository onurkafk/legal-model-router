 "rules": [
  {
   "when": {
    "sent_back": true
   },
   "pick": "escalated",
   "why": "A lawyer rejected the output; no benchmark average outweighs that."
  },
  {
   "when": {
    "classifier": "unavailable"
   },
   "row": "overall",
   "pick": "best",
   "why": "Nothing is known about the request, so take the overall #1."
  },
  {
   "when": {
    "section_confidence_below": 0.7
   },
   "row": "overall",
   "pick": "best",
   "why": "The kind of work is unsettled; a wrong guess could send law-dependent work cheap."
  },
  {
   "when": {
    "work_type": "new_drafting"
   },
   "unless": {
    "drafting_complexity": "standard_form",
    "probability_at_least": 0.7
   },
   "pick": "escalated",
   "why": "A bespoke document drafted from nothing goes to Claude Opus 5.5 (operator decision, 2026-11-23). No Vals board measures drafting from nothing; on legalbenchmarks.ai contract work (Nov 2026) Opus 5.5 is joint #1 (48.4% of tasks, 91.7% of criteria) and Gemini 4 Argon, #3 on Vals Business & Commercial, passes 25.8%."
  },
  {
   "when": {
    "research_or_drafting_at_least": 0.3
   },
   "unless": {
    "work_type": "new_drafting",
    "drafting_complexity": "standard_form",
    "probability_at_least": 0.7
   },
   "pick": "best",
   "why": "The model must supply the law or design a bespoke document. Measured: 31/31 recall on the fresh holdout."
  },
  {
   "when": {
    "work_type": "new_drafting"
   },
   "pick": "efficient",
   "why": "An NDA, power of attorney or board resolution from a few facts. 0/13 bespoke drafts were let through."
  },
  {
   "when": {
    "section": [
     "data_extraction",
     "summary_or_chronology",
     "translation"
    ]
   },
   "pick": "economy",
   "why": "Bounded by text already in the prompt; the model does not have to know any law."
  },
  {
   "when": {
    "work_type": "not_legal_work"
   },
   "row": "overall",
   "pick": "economy",
   "why": "Scheduling, billing and other admin."
  },
  {
   "when": {},
   "pick": "efficient",
   "why": "Work from supplied material, checked against that material."
  }
